NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Páginas legales (/terminos y /privacidad): email de contacto, y "1" cuando las revise un abogado (oculta el aviso de borrador).
NEXT_PUBLIC_CONTACTO_EMAIL=
NEXT_PUBLIC_LEGAL_REVISADO=
# Avisos push (Web Push). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@pedi.app
# Service role de Supabase: SOLO en el servidor (Vercel), nunca con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido con el Database Webhook de pedidos
PUSH_WEBHOOK_SECRET=
